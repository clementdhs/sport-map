# Copy to .env and fill in. Never commit .env.

# Supabase — Project Settings > API Keys
NUXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...), safe for the browser
NUXT_PUBLIC_SUPABASE_KEY=
# Secret key (sb_secret_...), server only — bypasses RLS. Not needed yet.
NUXT_SUPABASE_SECRET_KEY=

# MapTiler — https://cloud.maptiler.com/account/keys/ (exposed to the browser: restrict it to your domains)
NUXT_PUBLIC_MAPTILER_KEY=

# OpenRouteService — https://openrouteservice.org/dev/ (server only, needed from step 2)
NUXT_OPENROUTESERVICE_KEY=
