{
  "name": "sport-map",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:local": "node scripts/dev-local.mjs",
    "pr:impact": "node scripts/pr-impact.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p service-worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:loop-sentences": "vitest run --config vitest.llm.config.ts",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "pwa:assets":"pwa-assets-generator",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:icons": "node scripts/android-icons.mjs",
    "db:start": "supabase start -x realtime,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > shared/types/database.types.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@iconify-json/lucide": "^1.2.156",
    "@maplibre/maplibre-gl-style-spec": "^26.8.0",
    "@nuxt/ui": "^4.12.2",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/supabase": "^2.1.0",
    "@pinia/nuxt": "^1.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/nuxt": "^11.14.0",
    "@tmcw/togeojson": "^7.1.4",
    "@turf/turf": "^7.4.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "fflate": "^0.8.3",
    "fit-file-parser": "6.2.10",
    "maplibre-gl": "^6.19.0",
    "nuxt": "^4.6.4",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.43",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@playwright/test": "^1.65.1",
    "@types/geojson": "^7946.0.16",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "otpauth": "^9.6.0",
    "sharp": "^0.35.5",
    "supabase": "^2.122.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
