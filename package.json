  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:local": "node scripts/dev-local.mjs",
    "pr:impact": "node scripts/pr-impact.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p service-worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
