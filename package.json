    "db:stop": "supabase stop",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > shared/types/database.types.ts"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
