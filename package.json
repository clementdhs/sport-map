    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/supabase": "^2.0.10",
    "@pinia/nuxt": "^1.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/nuxt": "^11.1.0",
    "@tmcw/togeojson": "^7.1.2",
    "@turf/turf": "^7.4.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "fflate": "^0.8.3",
    "maplibre-gl": "^6.11.2",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
